<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
 <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
 <application android:label="Party Crashers Widgets" android:icon="@drawable/app_icon" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
  <activity android:name=".WidgetSetupActivity" android:exported="true" android:label="Set up your event widget">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/></intent-filter>
   <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="partycrashers" android:host="widget" android:pathPrefix="/setup"/></intent-filter>
  </activity>
  <receiver android:name=".EventsWidget" android:exported="false">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/events_widget"/>
  </receiver>
  <receiver android:name=".WidgetPinnedReceiver" android:exported="false"/>
  <service android:name=".WidgetRefreshService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true"/>
 </application>
</manifest>
